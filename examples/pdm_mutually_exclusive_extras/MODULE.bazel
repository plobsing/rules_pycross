module(
    name = "example_pdm_mutually_exclusive_extras",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_python", version = "1.5.0")
bazel_dep(name = "rules_pycross", version = "0.8.0")
bazel_dep(name = "aspect_rules_py", version = "1.6.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../..",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.10",
)

lock_import = use_extension("@rules_pycross//pycross/extensions:lock_import.bzl", "lock_import")
lock_import.import_pdm(
    lock_file = "//:pdm.spark34.lock",
    optional_groups = ["spark34"],
    project_file = "//:pyproject.toml",
    repo = "pdm_spark34",
)
lock_import.import_pdm(
    lock_file = "//:pdm.spark35.lock",
    optional_groups = ["spark35"],
    project_file = "//:pyproject.toml",
    repo = "pdm_spark35",
)
lock_import.import_pdm(
    lock_file = "//:pdm.spark40.lock",
    optional_groups = ["spark40"],
    project_file = "//:pyproject.toml",
    repo = "pdm_spark40",
)
lock_import.package(
    name = "pyspark",
    build_dependencies = [
        "setuptools",
    ],
    repo = "pdm_spark34",
)
lock_import.package(
    name = "pyspark",
    build_dependencies = [
        "setuptools",
    ],
    repo = "pdm_spark35",
)
lock_import.package(
    name = "pyspark",
    build_dependencies = [
        "setuptools",
    ],
    repo = "pdm_spark40",
)

lock_repos = use_extension("@rules_pycross//pycross/extensions:lock_repos.bzl", "lock_repos")
use_repo(lock_repos, "pdm_spark34", "pdm_spark35", "pdm_spark40")
